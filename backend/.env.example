# Optional direct-provider credentials for configured models/fallbacks.
GEMINI_API_KEY=
GROQ_API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Preferred answer provider; fallback runs once if it fails.
OPENROUTER_API_KEY=
ANSWER_MODEL=openrouter:anthropic/claude-sonnet-4.6
FALLBACK_MODEL=openrouter:google/gemini-2.5-pro
# Exactly two models. Reviews never silently substitute one member for another.
COUNCIL_MODELS=openrouter:anthropic/claude-sonnet-4.6,openrouter:google/gemini-2.5-pro
CHAIR_MODEL=openrouter:anthropic/claude-sonnet-4.6
CLARIFICATION_MODEL=openrouter:anthropic/claude-sonnet-4.6
